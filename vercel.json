{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @arms-atlas/types build && pnpm --filter @arms-atlas/web build",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "data/processed/**",
      "memory": 512,
      "maxDuration": 15
    }
  }
}
